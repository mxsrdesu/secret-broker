# systemd unit for distributions without NixOS; the NixOS module builds the same unit.
# Install: see "other linux" in the README.
[Unit]
Description=Secret broker for coding agents
Wants=network-online.target
After=network-online.target

[Service]
# Started once the socket and the page accept connections; a reload waits until then.
Type=notify
ExecStart=/opt/secret-broker/bin/secret-brokerd
# systemctl reload: a broken policy is reported and the running one stays; a good one is reread.
ExecReload=/opt/secret-broker/bin/secret-brokerd check --reload $MAINPID
Environment=SECRET_BROKER_CONFIG=/etc/secret-broker/policy.toml
User=secret-broker
Group=secret-broker
StateDirectory=secret-broker
StateDirectoryMode=0700
RuntimeDirectory=secret-broker
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=5s
# `secret run` children are started as the calling user and must see /home and /tmp like any of that
# user's processes, so no ProtectHome/ProtectSystem/PrivateTmp. SETUID/SETGID switch to the user
# (cleared before exec); KILL forwards signals to a child that no longer runs as this uid.
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_KILL
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
